GATE zero    0  O=CONST0;
GATE one     0  O=CONST1;

GATE inv     1  O=!a;             PIN * INV     1 999 1 0 1 0
GATE buf     1  O=a;              PIN * NONINV  1 999 1 0 1 0

GATE nand2   1  O=!(a*b);         PIN * INV     1 999 1 0 1 0
GATE nor2    1  O=!(a+b);         PIN * INV     1 999 1 0 1 0
GATE and2    1  O=(a*b);          PIN * NONINV  1 999 1 0 1 0
GATE or2     1  O=(a+b);          PIN * NONINV  1 999 1 0 1 0
GATE xor2    2  O=(a^b);          PIN * UNKNOWN 1 999 1 0 1 0
GATE xnor2   2  O=!(a^b);         PIN * UNKNOWN 1 999 1 0 1 0

GATE nand3   2  O=!(a*b*c);       PIN * INV     1 999 1 0 1 0
GATE nor3    2  O=!(a+b+c);       PIN * INV     1 999 1 0 1 0
GATE and3    2  O=(a*b*c);        PIN * NONINV  1 999 1 0 1 0
GATE or3     2  O=(a+b+c);        PIN * NONINV  1 999 1 0 1 0

GATE nand4   3  O=!(a*b*c*d);     PIN * INV     1 999 1 0 1 0
GATE nor4    3  O=!(a+b+c+d);     PIN * INV     1 999 1 0 1 0
GATE and4    3  O=(a*b*c*d);      PIN * NONINV  1 999 1 0 1 0
GATE or4     3  O=(a+b+c+d);      PIN * NONINV  1 999 1 0 1 0

GATE oai21   2  O=!((a+b)*c);     PIN * INV     1 999 1 0 1 0
GATE aoi21   2  O=!((a*b)+c);     PIN * INV     1 999 1 0 1 0
GATE oai22   3  O=!((a+b)*(c+d)); PIN * INV     1 999 1 0 1 0
GATE aoi22   3  O=!((a*b)+(c*d)); PIN * INV     1 999 1 0 1 0

GATE mux2    3  O=(c*b)+(!c*a);   PIN * UNKNOWN 1 999 1 0 1 0
GATE maj3    3  O=(a*b)+(b*c)+(a*c); PIN * NONINV 1 999 1 0 1 0